# Скопируйте в .env на сервере и задайте два разных случайных значения.
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
DEBUG=0
WAREHOUSE_HTTPS=1
WAREHOUSE_PORT=8000
# Только домен, без схемы, пути и порта.
WAREHOUSE_PUBLIC_HOST=warehouse.example.com
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
