# Локальный стенд. Задайте два разных случайных значения перед первым запуском.
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
WAREHOUSE_HTTPS=0
WAREHOUSE_PORT=8000
# Порт PostgreSQL на хосте используется только с compose.dev.yaml.
WAREHOUSE_DB_PORT=5433
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
